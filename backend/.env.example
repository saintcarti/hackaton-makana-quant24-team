# Copia a .env (no se sube al repo). Todo es opcional para correr en local.
PORT=8787

# Protege /api/demo/*, /api/jobs/* y /api/telegram/set-webhook con el header x-admin-token.
# Déjalo vacío en local; en producción/demo define un valor y compártelo solo con el front.
ADMIN_TOKEN=

# Orígenes permitidos por CORS (coma-separados). Vacío = "*".
CORS_ORIGIN=

# Persistencia SOLO para correr en Node fuera de Cloudflare. En Workers el estado vive en un Durable Object.
# Sin esto, en Node el estado vive en memoria (se pierde al reiniciar).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canal principal del demo: Telegram (token de BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Clasificación de lenguaje natural con Cloudflare Workers AI (opcional; sin esto funcionan las reglas locales).
# En Workers se usa el binding AI (no requiere token). En local/Node se usa REST con estas dos variables.
# El token necesita permiso "Workers AI"; para desplegar con wrangler necesita además "Workers Scripts: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Ganador del eval (14/14, ~1,4 s): @cf/deepseek-ai/deepseek-v4.1-flash-1017. Ver `pnpm eval:models`.
CF_AI_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
CF_AI_MAX_TOKENS=
# JSON extra para el modelo. Por defecto apaga el razonamiento: {"chat_template_kwargs":{"thinking":false}}
CF_AI_EXTRA_JSON=

# Texto de sede en las citas.
GYM_VENUE=tu gym de Ñuñoa
