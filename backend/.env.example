# Copia a .env (no se sube al repo). Todo es opcional para correr en local.
PORT=8787

# Protege /api/demo/*, /api/jobs/* y /api/telegram/set-webhook con el header x-admin-token.
# Déjalo vacío en local; en producción/demo define un valor y compártelo solo con el front.
ADMIN_TOKEN=

# Orígenes permitidos por CORS (coma-separados). Vacío = "*".
CORS_ORIGIN=

# Persistencia. Sin esto el estado vive en memoria (se pierde al reiniciar / en serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canal principal del demo: Telegram (token de BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Clasificación de lenguaje natural (opcional; sin llave funcionan las reglas locales).
# API compatible con OpenAI chat/completions. Ajusta el modelo al que tengan disponible.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Texto de sede en las citas.
GYM_VENUE=tu gym de Ñuñoa
