# URL base de la API de La Cita (sin /api al final)
VITE_API_URL=http://localhost:8787

# OAuth Client ID de Google (tipo "Aplicación web"). Sin esto, la web funciona solo con Camila sintética.
# Orígenes autorizados: http://localhost:5173 y la URL de Vercel.
VITE_GOOGLE_CLIENT_ID=

# Usuario del bot de Telegram, sin @ (para el enlace t.me/<bot>)
VITE_TELEGRAM_BOT=
