# URL base de la API de La Cita (sin /api al final)
VITE_API_URL=http://localhost:8787

# DÉJALO VACÍO si el backend tiene Google configurado: la conexión real se hace en el servidor (botón «Conectar Google Calendar» del panel de demo).
# Solo para el login de Google en el navegador (alternativo): OAuth Client ID tipo "Aplicación web".
# Orígenes autorizados: http://localhost:5173 y la URL de Vercel.
VITE_GOOGLE_CLIENT_ID=

# Usuario del bot de Telegram, sin @ (para el enlace t.me/<bot>)
VITE_TELEGRAM_BOT=
